{
  "version": 2,
  "builds": [
    {
      "src": "backend/*.py", 
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)", 
      "dest": "backend/index.py"
    },
    {
      "src": "/(.*\\.(?:js|css|map|ico|png|jpg|jpeg|gif|svg|webp))",
      "dest": "dist/browser/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "dist/browser/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "dist/browser/index.html"
    }
  ]
}