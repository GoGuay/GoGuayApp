{
    "version": 2,
    "functions": {
        "backend/app.py": {
            "runtime": "@vercel/python",
            "includeFiles": "backend/**"
        }
    },
    "builds": [
        {
            "src": "backend/app.py",
            "use": "@vercel/python"
        },
        {
            "src": "frontend/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "www/browser"
            }
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "backend/app.py"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/frontend/index.html"
        }
    ]
}