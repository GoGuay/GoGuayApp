{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json", 
      "use": "@vercel/static-build",
      "config": {
        "buildCommand": "npm run build",
        "distDir": "dist/browser"
      }
    },
    {
      "src": "backend/*.py", 
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)", 
      "dest": "backend/index.py"
    },
    {
      "src": "/(.*\\.(?:js|css|map|ico|ttf|woff2))",
      "dest": "frontend/dist/browser/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "frontend/dist/browser/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/dist/browser/index.html"
    }
  ]
}