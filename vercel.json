{
    "version": 2,
    "builds": [
        {
            "src": "backend/app.py",
            "use": "@vercel/python"
        },
        {
            "src": "frontend/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "www"
            }
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "backend/app.py"
        },
        {
            "src": "/assets/(.*)",
            "dest": "/frontend/www/assets/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/frontend/www/$1",
            "check": true
        },
        {
            "src": "/(.*)",
            "dest": "/frontend/www/index.html"
        }
    ]
}