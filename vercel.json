{
  "version": 2,
  "routes": [
    {
      "src": "/(.*\\.(?:js|css|map|ico|ttf|woff2|png|jpg|jpeg|gif|svg|webp))",
      "dest": "dist/browser/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "dist/browser/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "dist/browser/index.html"
    }
  ]
}