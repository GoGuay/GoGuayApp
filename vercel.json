{
    "version": 2,
    "functions": {
        "backend/app.py": {
            "maxDuration": 10
        }
    },
    "builds": [
        {
            "src": "backend/app.py",
            "use": "@vercel/python"
        },
        {
            "src": "frontend/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "www"
            }
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/backend/app.py"
        },
        {
            "source": "/(.*)",
            "destination": "/frontend/www/broswer/index.html"
        }
    ]
}